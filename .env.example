# Copy to .env for local development. Every value has a working default that
# matches docker-compose.yml, so the only required step is `docker compose up`.

NODE_ENV=development
LOG_LEVEL=debug

# Migrations run as the owner; the app connects as ctem_app so RLS applies.
DATABASE_URL=postgresql://ctem:ctem@localhost:5432/ctem?schema=public
DATABASE_APP_URL=postgresql://ctem_app:ctem_app@localhost:5432/ctem?schema=public

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ctem-artifacts
S3_ACCESS_KEY_ID=ctem
S3_SECRET_ACCESS_KEY=ctem-secret
S3_FORCE_PATH_STYLE=true

OIDC_ISSUER=http://localhost:8080/realms/ctem
OIDC_AUDIENCE=ctem-api
# Rotate this in every environment; it signs the internal principal header.
INTERNAL_TOKEN_SECRET=dev-internal-secret-change-me

IDENTITY_SERVICE_URL=http://localhost:3001
ASSET_SERVICE_URL=http://localhost:3002
ORCHESTRATOR_SERVICE_URL=http://localhost:3003
FINDINGS_SERVICE_URL=http://localhost:3004
RISK_SERVICE_URL=http://localhost:3005
REPORTING_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007

# GitHub / GitLab / AWS / GCP / Azure / ECR / GCR / ACR / Docker Hub discovery
# and CSPM. GitHub/GitLab tokens are optional (public repos only without them).
# AWS, ECR, GCP, GCR, Azure, ACR, Docker Hub, and cloud_posture have no
# public-listing/evaluate path and fail closed without the platform-operated
# pair/triple. env: is platform-operated, not tenant-writable: only GITHUB_* /
# GITLAB_* / AWS_* / GCP_* / AZURE_* / DOCKERHUB_* names resolve. Integrations
# reference the secret as credentialRef "env:GITHUB_TOKEN", "env:GITLAB_TOKEN",
# "env:AWS_ACCESS_KEY_ID", "env:GCP_CLIENT_EMAIL", "env:AZURE_CLIENT_ID", or
# "env:DOCKERHUB_TOKEN". GitLab listing/clone is gitlab.com unless the
# connector sets baseUrl (https only, no userinfo, no git@). Extra tenant host
# fields are refused. AWS/ECR API hosts are *.amazonaws.com (ECR listing is
# api.ecr.{region}.amazonaws.com only — not dkr.ecr); GCP API hosts are
# *.googleapis.com; Azure is login.microsoftonline.com + management.azure.com;
# Docker Hub listing is hub.docker.com only (not registry-1.docker.io /
# index.docker.io) — tenant config cannot set an endpoint. Docker Hub
# digest pull (scanner-container-iac) reuses the same env:DOCKERHUB_* pair
# on registry-1.docker.io + auth.docker.io only. CSPM reuses the
# same credential refs and host allowlists.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITLAB_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Slack incoming webhook for policy.violated notify. Platform-operated:
# notification-service resolves credentialRef "env:SLACK_WEBHOOK_URL" only
# (SLACK_* allowlist, same pattern as GITHUB_*/GITLAB_*). The URL must be
# https://hooks.slack.com/services/... — tenant config/body/query cannot set it.
SLACK_WEBHOOK_URL=

# Jira Cloud for policy.violated ticket. Platform-operated:
# notification-service resolves credentialRef "env:JIRA_API_TOKEN" only
# (JIRA_* allowlist, same pattern as SLACK_*/GITHUB_*/GITLAB_*/AWS_*).
# Site must be https://{site}.atlassian.net — tenant config/body/query
# cannot set it. Fail closed if any required JIRA_* is missing. Self-hosted
# Jira is later.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# JIRA_ISSUE_TYPE=Task

# NVD is heavily rate-limited without a key; request one for real workloads.
NVD_API_KEY=

SCANNER_CONCURRENCY=4
SCANNER_JOB_TIMEOUT_MS=900000

# Inter-service circuit breaker + retry budget (api-gateway ServiceProxy only).
# Platform-operated CTEM_CB_* allowlist — not tenant-writable. Invalid values
# fail closed (gateway will not start / will not silently succeed). Defaults:
#   CTEM_CB_FAILURE_THRESHOLD=5   # open after N failures in the window
#   CTEM_CB_WINDOW_MS=30000
#   CTEM_CB_COOLDOWN_MS=15000     # then one half-open probe
#   CTEM_CB_MAX_ATTEMPTS=3        # 1 try + 2 retries; timeouts / 502–504 only
#   CTEM_CB_BASE_DELAY_MS=100     # exponential backoff + full jitter
#   CTEM_CB_TIMEOUT_MS=30000
# CTEM_CB_FAILURE_THRESHOLD=5
# CTEM_CB_WINDOW_MS=30000
# CTEM_CB_COOLDOWN_MS=15000
# CTEM_CB_MAX_ATTEMPTS=3
# CTEM_CB_BASE_DELAY_MS=100
# CTEM_CB_TIMEOUT_MS=30000

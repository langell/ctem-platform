# Copy to .env for local development. Every value has a working default that
# matches docker-compose.yml, so the only required step is `docker compose up`.

NODE_ENV=development
LOG_LEVEL=debug

# Migrations run as the owner; the app connects as ctem_app so RLS applies.
DATABASE_URL=postgresql://ctem:ctem@localhost:5432/ctem?schema=public
DATABASE_APP_URL=postgresql://ctem_app:ctem_app@localhost:5432/ctem?schema=public

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ctem-artifacts
S3_ACCESS_KEY_ID=ctem
S3_SECRET_ACCESS_KEY=ctem-secret
S3_FORCE_PATH_STYLE=true

OIDC_ISSUER=http://localhost:8080/realms/ctem
OIDC_AUDIENCE=ctem-api
# Rotate this in every environment; it signs the internal principal header.
INTERNAL_TOKEN_SECRET=dev-internal-secret-change-me

IDENTITY_SERVICE_URL=http://localhost:3001
ASSET_SERVICE_URL=http://localhost:3002
ORCHESTRATOR_SERVICE_URL=http://localhost:3003
FINDINGS_SERVICE_URL=http://localhost:3004
RISK_SERVICE_URL=http://localhost:3005
REPORTING_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007

# GitHub / GitLab / AWS discovery. GitHub/GitLab tokens are optional (public
# repos only without them). AWS has no public-listing path and fails closed
# without AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY. env: is platform-operated,
# not tenant-writable: only GITHUB_* / GITLAB_* / AWS_* names resolve.
# Integrations reference the secret as credentialRef "env:GITHUB_TOKEN",
# "env:GITLAB_TOKEN", or "env:AWS_ACCESS_KEY_ID". GitLab.com listing/clone is
# hardcoded; AWS API hosts are *.amazonaws.com — tenant config cannot set an
# endpoint. Self-hosted GitLab is later.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITLAB_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Slack incoming webhook for policy.violated notify. Platform-operated:
# notification-service resolves credentialRef "env:SLACK_WEBHOOK_URL" only
# (SLACK_* allowlist, same pattern as GITHUB_*/GITLAB_*). The URL must be
# https://hooks.slack.com/services/... — tenant config/body/query cannot set it.
SLACK_WEBHOOK_URL=

# NVD is heavily rate-limited without a key; request one for real workloads.
NVD_API_KEY=

SCANNER_CONCURRENCY=4
SCANNER_JOB_TIMEOUT_MS=900000

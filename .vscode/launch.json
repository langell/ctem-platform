{
  // Debug configs for the CTEM Nest services. Each launches the compiled
  // dist/main.js under the debugger with --watch, so js-debug re-attaches
  // automatically when tsc rebuilds and node restarts the process.
  //
  // Keep `tsc -b tsconfig.build.json --watch` running (dev.sh does this, or
  // run the "tsc: watch (workspace)" task) so dist/ stays fresh.
  //
  // Do NOT add a PORT env var here — bootstrapService lets PORT override the
  // per-service port, so a shared PORT would make every service bind the same one.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "API Gateway (3000)",
      "program": "${workspaceFolder}/apps/api-gateway/dist/main.js",
      "cwd": "${workspaceFolder}/apps/api-gateway",
      "runtimeArgs": ["--enable-source-maps", "--watch"],
      "envFile": "${workspaceFolder}/.env",
      "outFiles": [
        "${workspaceFolder}/apps/*/dist/**/*.js",
        "${workspaceFolder}/libs/*/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "presentation": { "group": "1-core", "order": 1 }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Identity Service (3001)",
      "program": "${workspaceFolder}/apps/identity-service/dist/main.js",
      "cwd": "${workspaceFolder}/apps/identity-service",
      "runtimeArgs": ["--enable-source-maps", "--watch"],
      "envFile": "${workspaceFolder}/.env",
      "outFiles": [
        "${workspaceFolder}/apps/*/dist/**/*.js",
        "${workspaceFolder}/libs/*/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "presentation": { "group": "1-core", "order": 2 }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Asset Service (3002)",
      "program": "${workspaceFolder}/apps/asset-service/dist/main.js",
      "cwd": "${workspaceFolder}/apps/asset-service",
      "runtimeArgs": ["--enable-source-maps", "--watch"],
      "envFile": "${workspaceFolder}/.env",
      "outFiles": [
        "${workspaceFolder}/apps/*/dist/**/*.js",
        "${workspaceFolder}/libs/*/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "presentation": { "group": "1-core", "order": 3 }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Orchestrator Service (3003)",
      "program": "${workspaceFolder}/apps/orchestrator-service/dist/main.js",
      "cwd": "${workspaceFolder}/apps/orchestrator-service",
      "runtimeArgs": ["--enable-source-maps", "--watch"],
      "envFile": "${workspaceFolder}/.env",
      "outFiles": [
        "${workspaceFolder}/apps/*/dist/**/*.js",
        "${workspaceFolder}/libs/*/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "presentation": { "group": "1-core", "order": 4 }
    },
    {
      "type": "node",
      "request": "launch",

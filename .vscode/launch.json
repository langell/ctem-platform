  "compounds": [
    {
      "name": "All core services (3000–3007)",
      "configurations": [
        "API Gateway (3000)",
        "Identity Service (3001)",
        "Asset Service (3002)",
        "Orchestrator Service (3003)",
        "Findings Service (3004)",
        "Risk Service (3005)",
        "Reporting Service (3006)",
        "Notification Service (3007)"
      ],
      "stopAll": true,
      "presentation": { "group": "0-compound", "order": 1 }
    },
    {
      "name": "All scanners (3100–3103)",
      "configurations": [
        "Scanner: SCA (3100)",
        "Scanner: SAST (3101)",
        "Scanner: Container/IaC (3102)",
        "Scanner: ASM (3103)"
      ],
      "stopAll": true,
      "presentation": { "group": "0-compound", "order": 2 }
    }
  ]
}

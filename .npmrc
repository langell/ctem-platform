# Hoist Prisma packages so `prisma generate` can resolve @prisma/client
# from any workspace package. Required for pnpm + Prisma in a monorepo.
# https://www.prisma.io/docs/guides/other/troubleshooting-orm/help-articles/nextjs-prisma-client-monorepo
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma/*

# Prisma 6 runs `pnpm add @prisma/client` without the -w flag during generate.
# This setting allows it to add to the workspace root without erroring.
ignore-workspace-root-check=true

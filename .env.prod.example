# Copy to .env.prod on the VM. Read by `make deploy-*` (docker compose --env-file).
# Generate each secret with: openssl rand -hex 24
# Passwords are interpolated into SQL and JSON; avoid quotes and backslashes.

# DNS A records for both names must point at the VM; Caddy issues TLS for them.
CTEM_DOMAIN=ctem.example.com
AUTH_DOMAIN=auth.example.com

# Postgres owner role (migrations) and the RLS-restricted app role.
POSTGRES_PASSWORD=
CTEM_APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

MINIO_ROOT_PASSWORD=
INTERNAL_TOKEN_SECRET=

# Keycloak admin console lives at https://$AUTH_DOMAIN/admin
KEYCLOAK_ADMIN_PASSWORD=
# Confidential ctem-api client (used by tools/demo-token.sh with OIDC_CLIENT_SECRET)
OIDC_API_CLIENT_SECRET=
# Password for the seeded `analyst` login — this env is on the public internet.
DEMO_PASSWORD=

LOG_LEVEL=info
SCANNER_CONCURRENCY=4
SCANNER_JOB_TIMEOUT_MS=900000

# Optional connector / feed credentials — same meaning as .env.example.
GITHUB_TOKEN=
GITLAB_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
NVD_API_KEY=
